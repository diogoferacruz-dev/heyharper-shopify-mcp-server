# ---- MCP endpoint auth (STRONGLY recommended) ----
# A long random string. Clients must send: Authorization: Bearer <this>
# If unset, the endpoint is UNAUTHENTICATED. Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: change the MCP path (default /mcp). An unguessable path adds a second layer.
# MCP_PATH=/mcp

# Optional: Shopify Admin API version (default 2024-10)
# SHOPIFY_API_VERSION=2024-10

# ---- Per-store Shopify Admin API credentials ----
# A store goes LIVE only when BOTH its DOMAIN and TOKEN are set, so you can
# roll out one store at a time. Tokens look like shpat_xxxxxxxx.
# (UK domain has a built-in default but still needs its TOKEN.)

HH_US_DOMAIN=
HH_US_TOKEN=

HH_EU_DOMAIN=
HH_EU_TOKEN=

HH_UK_DOMAIN=hey-harper-shop-uk.myshopify.com
HH_UK_TOKEN=

HH_BR_DOMAIN=
HH_BR_TOKEN=

HH_MX_DOMAIN=
HH_MX_TOKEN=
